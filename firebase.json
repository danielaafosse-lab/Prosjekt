{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      ".playwright-mcp/**",
      ".vscode/**",
      ".claude/**",
      "src/**",
      "docs/**",
      "*.md",
      "package.json",
      "package-lock.json",
      "tsconfig.json",
      "eslint.config.js",
      "vitest.config.js",
      ".prettierrc.json",
      ".prettierignore",
      "tailwind.config.js",
      "firestore.rules",
      "firestore.indexes.json",
      "**/*.test.js",
      "**/*.spec.js"
    ],
    "headers": [
      {
        "source": "**/*.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
