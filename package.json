{
  "name": "econsim",
  "version": "5.2.1",
  "description": "Norsk klasseromsøkonomisimulator for ungdomsskolen",
  "type": "module",
  "private": true,
  "scripts": {
    "build:css": "npx tailwindcss -i ./src/input.css -o ./css/output.css --minify",
    "watch:css": "npx tailwindcss -i ./src/input.css -o ./css/output.css --watch",
    "build": "npm run build:css",
    "lint": "eslint js",
    "lint:fix": "eslint js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run typecheck && npm test",
    "deploy": "npm run build && npx firebase deploy --only hosting"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-import-x": "^4.16.2",
    "firebase-tools": "^14.22.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
